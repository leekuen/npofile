# NPOFile Docker Compose 的設定：複製成 .env 後填值（.env 不進版控）
#   cp .env.example .env

# ── 必填 ──

# 對外網址（不加 https://）
DOMAIN=npofile.leekuen.com
# Django 金鑰：python3 -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# 資料庫密碼：只用英數與 - _（會放進連線網址）。python3 -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
# Cloudflare Tunnel 的 token（Zero Trust → Networks → Tunnels → 建立 tunnel 後複製）
CLOUDFLARE_TUNNEL_TOKEN=
# 一起啟動的選配服務：tunnel＝cloudflared（對外）、autoupdate＝自動更新（GitHub 的 prod 有新版就自己更新）
# 本機測試不想連 Cloudflare 就拿掉 tunnel
COMPOSE_PROFILES=tunnel,autoupdate

# ── 資料放哪（主機上的路徑；可指到外接硬碟）──

# PostgreSQL 的資料
PG_DATA_DIR=./data/postgres
# 每天的資料庫備份
BACKUP_DIR_HOST=./data/backups
# 排程工作的紀錄
LOG_DIR_HOST=./data/logs

# ── 選填 ──

# 自動更新跟哪條分支、幾秒檢查一次
AUTO_UPDATE_BRANCH=prod
AUTO_UPDATE_INTERVAL=300

# 排程失敗通知（https://healthchecks.io 的 Ping key）；沒設只寫紀錄
HEALTHCHECKS_PING_KEY=
# 本機備份留幾天
BACKUP_KEEP_DAYS=14
# 本機測試時從這台主機連 http://localhost:8080（只綁 127.0.0.1，外面連不到）
NGINX_PORT=8080
# 只在用 http://localhost 測試登入時改成 false；正式環境一定維持 true（登入 cookie 只走 HTTPS）
DJANGO_SECURE_COOKIES=true
# 爬蟲每個請求的間隔（秒）
CRAWLER_MIN_INTERVAL=1.0
# 個人捐款人在同一活動累計達這個金額才存姓名並顯示（元）
DONOR_INDIVIDUAL_THRESHOLD=100000
# 組織官網財報讀數字（crawl orgsite）：用 Claude 訂閱帳號讀，不另外付費。
# 在任何一台登入過 Claude Code 的電腦跑 `claude setup-token`，把印出來的權杖貼在這裡；不設就只收報告清單
CLAUDE_CODE_OAUTH_TOKEN=
# 每次爬取最多讀幾份（訂閱額度有上限，讀太多那幾個小時你自己用 Claude 會被限制）
FINANCIAL_EXTRACT_MAX_PER_RUN=10
