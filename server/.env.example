# 複製成 server/.env 後填值（.env 不進版控）
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 正式環境用 PostgreSQL；不設就用本機 SQLite
# DATABASE_URL=postgres://npofile:password@localhost:5432/npofile
CRAWLER_MIN_INTERVAL=1.0
# 捐贈人清冊：個人在同一活動累計達這個金額才存姓名並顯示（元）
DONOR_INDIVIDUAL_THRESHOLD=100000
