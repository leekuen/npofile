# 複製成 server/.env 後填值（.env 不進版控）
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 正式環境用 PostgreSQL；不設就用本機 SQLite
# DATABASE_URL=postgres://npofile:password@localhost:5432/npofile
CRAWLER_MIN_INTERVAL=1.0
# 捐贈人清冊：個人在同一活動累計達這個金額才存姓名並顯示（元）
DONOR_INDIVIDUAL_THRESHOLD=100000
# 組織官網財報（crawl orgsite）：設了才用 Claude 讀報告 PDF 的數字，會產生 API 費用；不設只收報告清單
# ANTHROPIC_API_KEY=
# FINANCIAL_EXTRACT_MODEL=claude-opus-5-5
# 不想付 API 費用：改用 Claude 訂閱帳號讀。在裝了 Claude Code 的機器跑 `claude setup-token`，權杖貼在下面；每次爬取最多讀幾份
# CLAUDE_CODE_OAUTH_TOKEN=
# FINANCIAL_EXTRACT_MAX_PER_RUN=10
# 組織官網成立宗旨的一句話介紹（LK-54）：同一把 ANTHROPIC_API_KEY；沒設就取原文第一句
# MISSION_SUMMARY_MODEL=claude-haiku-5-5
# MISSION_SUMMARY_MAX_PER_RUN=500
# 環境部列管事業污染源裁處（crawl moenv_penalties）：到 https://data.moenv.gov.tw/ 註冊會員後免費申請 API 金鑰；不設就略過這個來源
# MOENV_API_KEY=
# 排程失敗通知（deploy/run-job.sh）：Healthchecks.io 專案的 Ping key；不設就只寫紀錄、不通知
# HEALTHCHECKS_PING_KEY=
# 資料庫每日備份（deploy/backup-db.sh，只在 PostgreSQL 有用）
# BACKUP_DIR=/home/npofile/backups
# BACKUP_KEEP_DAYS=14
# BACKUP_RCLONE_REMOTE=spaces:npofile-backups/db
# BACKUP_REMOTE_KEEP_DAYS=60
