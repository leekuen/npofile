# 前台（Next.js）：只聽本機 3000；/api/* 由它自己轉給 Django
# 放到 /etc/systemd/system/npofile-web.service
[Unit]
Description=NPOFile Web (Next.js)
After=network.target npofile-api.service

[Service]
User=npofile
Group=npofile
WorkingDirectory=/home/npofile/app/web
Environment=NODE_ENV=production
Environment=API_BASE=http://127.0.0.1:8000
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
