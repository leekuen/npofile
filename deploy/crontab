# npofile 帳號的排程：crontab -u npofile deploy/crontab（會整個取代該帳號原本的 crontab）
# 時間是伺服器時區；先跑 timedatectl set-timezone Asia/Taipei
# 每個工作都包在 run-job.sh 裡：輸出寫進 /home/npofile/logs/<名稱>.log，
# 失敗或沒準時跑完，Healthchecks.io 會寄信（要在 server/.env 設 HEALTHCHECKS_PING_KEY，見 deploy/README.md〈排程失敗通知〉）
SHELL=/bin/bash
APP=/home/npofile/app/server
JOB=/home/npofile/app/deploy/run-job.sh

# 每天 02:00 備份資料庫（在爬蟲動資料之前，爬壞了可以退回前一天）
0 2 * * * $JOB backup /home/npofile/app/deploy/backup-db.sh
# 每天 02:30 跑所有啟用中的爬蟲來源（每次抓幾筆、最多跑幾分鐘照管理後台的設定；勸募活動預設 120 分鐘、接著上次進度）
30 2 * * * $JOB crawl bash -c "cd $APP && .venv/bin/python manage.py crawl all"
# 每天 05:30 清掉近 5 年以外的資料、重算揭露指數（「近五年」隨日期移動）；重新對上市櫃公司 ESG 到企業捐款人（LK-39）
30 5 * * * $JOB scores bash -c "cd $APP && .venv/bin/python manage.py prune_old_records && .venv/bin/python manage.py recompute_scores && .venv/bin/python manage.py match_court_registrations && .venv/bin/python manage.py sync_esg --link-only"
# 每週日 06:30 更新上市櫃公司 ESG 彙總資料並對到企業捐款人（LK-39；證交所約每年 6 月更新年度資料）
30 6 * * 0 $JOB esg bash -c "cd $APP && .venv/bin/python manage.py sync_esg"
# 每週日 07:00 從組織官網找成立宗旨與一句話介紹（LK-54；理念不常變，不放進每晚的 crawl all；抓到的先待審核）
0 7 * * 0 $JOB mission bash -c "cd $APP && .venv/bin/python manage.py crawl orgsite_mission"
# 每分鐘看有沒有後台按的「排入完整爬取」（LK-26）；沒有就馬上結束，一次只跑一個
* * * * * cd $APP && .venv/bin/python manage.py run_crawl_requests >> /home/npofile/logs/crawl-requests.log 2>&1
